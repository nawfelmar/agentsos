# Copy to .env (npm run db:setup / ensure-env does this automatically):
#   cp .env.example .env
#
# SQLite path is resolved relative to the prisma/ directory (schema location).
# Local/dev .env may use an absolute file: URL to avoid path drift.
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_NAME="Relay"
NEXT_PUBLIC_DEMO_MODE="true"
# OPENAI_API_KEY=
# LIVEKIT_API_KEY=
# GOOGLE_CALENDAR_CLIENT_ID=
